# 复制成 scripts/hosts.env 再修改：cp scripts/hosts.env.example scripts/hosts.env
# 每台 Pi 写成 用户名@IP。先用 scripts/add_keys.sh 配好免密登录。
#
# HEAD：运行 llama-bench 的那台，也是唯一需要模型文件的一台（它自己也会跑一个 rpc-server）。
HEAD=cassian@192.168.31.30
# WORKERS：其余的 Pi，用空格分开。8 台的集群就是 1 个 HEAD + 7 个 WORKERS。
# 顺序有意义：run_bench.sh 用 NN=4 时，取 HEAD + 前 3 个 WORKERS。
WORKERS="rex@192.168.31.115"
RPC_PORT=50052
